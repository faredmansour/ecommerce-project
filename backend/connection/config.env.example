# ── Copy this file to config.env and fill in real values ──
# The app loads env from ./connection/config.env

# Core
PORT=8000
NODE_ENV=development
DB_URL="mongodb://127.0.0.1:27017/e-commerce"

# Auth (JWT): replace with a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m

# Frontend origins (comma-separated). Used for CORS and password-reset links.
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Optional integrations (left blank = feature gracefully disabled) ──

# Redis caching (product listings). Leave empty to skip caching.
REDIS_URL=

# Stripe payments. Without this, /api/payments/intent errors and the
# frontend falls back to Cash on Delivery.
STRIPE_SECRET_KEY=

# Paymob Sandbox only. Execution and Transaction Inquiry are both disabled by
# default. Keep all credentials TEST-scoped; no LIVE or generic-key fallback.
PAYMOB_ENVIRONMENT=TEST
PAYMOB_TEST_EXECUTION_ENABLED=false
PAYMOB_TEST_TRANSACTION_INQUIRY_ENABLED=false
PAYMOB_TEST_API_BASE_URL=https://accept.paymob.com
PAYMOB_TEST_API_KEY=
PAYMOB_TEST_PUBLIC_KEY=
PAYMOB_TEST_SECRET_KEY=
PAYMOB_TEST_HMAC_SECRET=
PAYMOB_TEST_INTEGRATION_ID=
# JSON map of key ID to 32-byte hex AES-GCM key; retain old keys for lazy rotation.
PAYMOB_CHECKOUT_RESULT_KEYRING=
PAYMOB_CHECKOUT_RESULT_ACTIVE_KEY_ID=
# Legacy v1 decryption only. Remove after all v1 ciphertexts have been migrated.
PAYMOB_CHECKOUT_RESULT_ENCRYPTION_KEY=

# Cloudinary image hosting. Without all three, uploads stay on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=alfredo-store

# SMTP email for account verification and password recovery. Without these,
# email delivery is unavailable; auth endpoints still return enumeration-safe responses.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Alfredo Store <no-reply@alfredo.test>"

# Google OpenID Connect. Register this exact callback URI in Google Cloud Console.
# GOOGLE_CLIENT_ID is public client metadata; keep GOOGLE_CLIENT_SECRET server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Sign in with Apple. Keep the .p8 private key server-side; enter literal \n for line breaks.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/api/auth/apple/callback
FRONTEND_URL=http://localhost:5173
